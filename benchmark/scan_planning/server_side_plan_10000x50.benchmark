# name: benchmark/scan_planning/server_side_plan_10000x50.benchmark
# description: Parse and convert a server-side scan plan of 10,000 data files with hex bounds on 50 columns
# group: [scan_planning]

name Iceberg server-side scan plan - 10000 files x 50 columns
group scan_planning

require avro

require parquet

require iceberg

# Requires: python3 scripts/scan_planning_mock_server.py 19131 10000 50
load
ATTACH '' AS mock (TYPE ICEBERG, URI 'http://127.0.0.1:19131', AUTHORIZATION_TYPE 'none', ACCESS_DELEGATION_MODE 'none');

run
SELECT count(*), sum(record_count) FROM iceberg_scan_plan('mock.default.wide');

result II
10000	100000
