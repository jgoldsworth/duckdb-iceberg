# name: test/sql/local/iceberg_scans/delete_aware_statistics.test
# description: count(*) is answered from manifest metadata when the applicable deletes provably remove a known number of rows
# group: [iceberg_scans]

include test/sql/init_requires

# Fixtures (data/persistent/delete_statistics, scripts/persistent/delete_statistics.py): three data files of 5 rows each
# (ids 0-4, 10-14, 20-24), 12 live rows after the deletes.
#   dv:             format v3, deletion vectors on two files, the third file has no deletes
#   refpos:         format v2, one position delete file per deleted-from file, each naming its data file
#   refpos_overlap: as refpos, but two position delete files name the same data file
# Also: delete_planning/pdel (position deletes that name no data file) and equality_deletes/... (equality deletes).

statement ok
PRAGMA explain_output = 'physical_only';

# Every delete is exact: the count comes from the metadata and no scan is planned

query II
EXPLAIN SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/dv');
----
physical_plan	<!REGEX>:(?s).*ICEBERG_SCAN.*

query I
SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/dv');
----
12

query II
EXPLAIN SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/refpos');
----
physical_plan	<!REGEX>:(?s).*ICEBERG_SCAN.*

query I
SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/refpos');
----
12

# The same counts from a scan of the rows
query II
SELECT count(*), list(id ORDER BY id) FROM iceberg_scan('data/persistent/delete_statistics/dv') WHERE id >= 0;
----
12	[0, 3, 4, 10, 11, 13, 14, 20, 21, 22, 23, 24]

query II
SELECT count(*), list(id ORDER BY id) FROM iceberg_scan('data/persistent/delete_statistics/refpos') WHERE id >= 0;
----
12	[0, 3, 4, 10, 11, 13, 14, 20, 21, 22, 23, 24]

# Declines: the count is not provable, so the rows are scanned and still counted correctly

# a data file with two position delete files naming it (positions may repeat across the files)
query II
EXPLAIN SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/refpos_overlap');
----
physical_plan	<REGEX>:(?s).*ICEBERG_SCAN.*

query I
SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/refpos_overlap');
----
12

query I
SELECT list(id ORDER BY id) FROM iceberg_scan('data/persistent/delete_statistics/refpos_overlap');
----
[0, 3, 4, 10, 11, 13, 14, 20, 21, 22, 23, 24]

# position deletes that do not name a data file
query II
EXPLAIN SELECT count(*) FROM iceberg_scan('data/persistent/delete_planning/pdel');
----
physical_plan	<REGEX>:(?s).*ICEBERG_SCAN.*

query I
SELECT count(*) FROM iceberg_scan('data/persistent/delete_planning/pdel');
----
16

# equality deletes
query II
EXPLAIN SELECT count(*) FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable');
----
physical_plan	<REGEX>:(?s).*ICEBERG_SCAN.*

query I
SELECT count(*) FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable');
----
2

# A table with equality deletes on some files and none on others still declines
query II
EXPLAIN SELECT count(*) FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned');
----
physical_plan	<REGEX>:(?s).*ICEBERG_SCAN.*

query I
SELECT count(*) FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned');
----
3

# A filter is never folded into the count
query I
SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/dv') WHERE id < 10;
----
3

query I
SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/dv') WHERE id = 1;
----
0

# Results do not depend on the optimizer
statement ok
PRAGMA disable_optimizer;

query IIIIII
SELECT
    (SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/dv')),
    (SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/refpos')),
    (SELECT count(*) FROM iceberg_scan('data/persistent/delete_statistics/refpos_overlap')),
    (SELECT count(*) FROM iceberg_scan('data/persistent/delete_planning/pdel')),
    (SELECT count(*) FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable')),
    (SELECT count(*) FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable_partitioned'));
----
12	12	12	16	2	3
