# Declines to prune: event_type is a partition field of the second manifest only, the first has no summary for it
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(user_id ORDER BY user_id) FROM iceberg_scan('data/persistent/hive_partitioned_table') WHERE event_type = 'purchase';
----
[67890, 97531]

query I
SELECT * FROM selection_log();
----
selected_data_manifests=2 total_data_manifests=2

# A manifest whose summary excludes the value is still skipped when the other one cannot be
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM iceberg_scan('data/persistent/hive_partitioned_table') WHERE event_type = 'zzz';
----
0

query I
SELECT * FROM selection_log();
----
selected_data_manifests=1 total_data_manifests=2

# One store serves every filtered view of a scan: differently filtered uses of the same scan must each see their own
# manifests
statement ok
CREATE VIEW pdel_view AS SELECT * FROM iceberg_scan('data/persistent/delete_planning/pdel');

query II
SELECT part, list(id ORDER BY id) FROM (
    SELECT * FROM pdel_view WHERE part = 1
    UNION ALL
    SELECT * FROM pdel_view WHERE part = 2
) GROUP BY part ORDER BY part;
----
1	[11, 12, 50, 51]
2	[21, 22, 60, 61]

query II
WITH t AS (SELECT * FROM iceberg_scan('data/persistent/delete_planning/pdel'))
SELECT a.part, list(DISTINCT b.id ORDER BY b.id) FROM (SELECT * FROM t WHERE part = 3) a JOIN (SELECT * FROM t WHERE part = 0) b ON a.id % 10 = b.id % 10 GROUP BY a.part;
----
3	[1, 2, 40, 41]

query II
SELECT a.part, list(a.id ORDER BY a.id) FROM iceberg_scan('data/persistent/delete_planning/pdel') a
JOIN (SELECT 2 AS part) b USING (part) GROUP BY a.part;
----
2	[21, 22, 60, 61]

query II
SELECT a.part, list(a.id ORDER BY a.id) FROM iceberg_scan('data/persistent/delete_planning/pdel') a
JOIN (SELECT unnest([0, 3]) AS part) b USING (part) WHERE a.ts < 500 GROUP BY a.part ORDER BY a.part;
----
0	[1, 2, 40, 41]
3	[31, 32]

statement ok
PREPARE by_part AS SELECT list(id ORDER BY id) FROM iceberg_scan('data/persistent/delete_planning/pdel') WHERE part = $1;

query I
EXECUTE by_part(1);
----
[11, 12, 50, 51]

query I
EXECUTE by_part(3);
----
[31, 32, 70, 71]

query I
EXECUTE by_part(1);
----
[11, 12, 50, 51]
