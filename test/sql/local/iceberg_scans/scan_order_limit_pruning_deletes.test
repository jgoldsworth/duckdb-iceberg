# name: test/sql/local/iceberg_scans/scan_order_limit_pruning_deletes.test
# description: ORDER BY ... LIMIT prunes data files on tables with deletes, counting only live rows
# group: [iceberg_scans]

include test/sql/init_requires

require json

# Fixtures: three data files of 5 rows each with disjoint id bounds (ids 0-4, 10-14, 20-24) and 12 live rows.
#   delete_statistics/dv:             deletion vectors on files 0 (ids 1, 2 -> 3 live) and 1 (id 12 -> 4 live)
#   delete_statistics/refpos:         one position delete file per file that names it, same live rows as dv
#   delete_statistics/refpos_overlap: file 0 has two position delete files naming it (inexact, counts 0)
#   equality_deletes: file 12 (ids 5, 6; id 6 equality-deleted, 1 live) and file 9 (ids 1-4; id 1-3 deleted, 1 live)
#   delete_scan_order/overlap:        deletion vectors, ts bounds interleave across the files (no file can be skipped)

statement ok
CALL enable_logging(['FileSystem', 'Iceberg']);

statement ok
CREATE MACRO opened_data_files(tbl) AS (
    SELECT count(DISTINCT regexp_extract(path, '[^/]*$')) FROM duckdb_logs_parsed('FileSystem')
    WHERE op = 'OPEN' AND regexp_extract(path, '[^/]*$') IN
        (SELECT regexp_extract(file_path, '[^/]*$') FROM iceberg_metadata(tbl) WHERE content = 'DATA')
);

# Pruned: the top files already hold enough live rows

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/refpos') ORDER BY id DESC LIMIT 3);
----
[24, 23, 22]

query I
SELECT opened_data_files('data/persistent/delete_statistics/refpos');
----
1

query I
SELECT count(*) >= 1 FROM duckdb_logs() WHERE message LIKE '%Scan Order Pushdown, kept 1 of 3%';
----
true

# The same query with the optimization disabled opens every data file
statement ok
PRAGMA disabled_optimizers='row_group_pruner';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/refpos') ORDER BY id DESC LIMIT 3);
----
[24, 23, 22]

query I
SELECT opened_data_files('data/persistent/delete_statistics/refpos');
----
3

statement ok
PRAGMA disabled_optimizers='';

# Deletion vectors: file 0 keeps 3 live rows, which is exactly the limit
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/dv') ORDER BY id LIMIT 3);
----
[0, 3, 4]

query I
SELECT opened_data_files('data/persistent/delete_statistics/dv');
----
1

# Declines: deletes remove rows from the top file, so the loop must keep another file

# the raw record count of file 0 is 5 but only 3 rows are live
foreach tbl dv refpos

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/{tbl}') ORDER BY id LIMIT 4);
----
[0, 3, 4, 10]

query I
SELECT opened_data_files('data/persistent/delete_statistics/{tbl}');
----
2

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/{tbl}') ORDER BY id LIMIT 7);
----
[0, 3, 4, 10, 11, 13, 14]

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/{tbl}') ORDER BY id LIMIT 8);
----
[0, 3, 4, 10, 11, 13, 14, 20]

# descending: file 2 holds 5 live rows, LIMIT 6 needs the next file
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/{tbl}') ORDER BY id DESC LIMIT 6);
----
[24, 23, 22, 21, 20, 14]

query I
SELECT opened_data_files('data/persistent/delete_statistics/{tbl}');
----
2

# LIMIT larger than the live row count: every file is needed and every live row returned
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/{tbl}') ORDER BY id LIMIT 100);
----
[0, 3, 4, 10, 11, 13, 14, 20, 21, 22, 23, 24]

query I
SELECT opened_data_files('data/persistent/delete_statistics/{tbl}');
----
3

# exactly the live row count
query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/{tbl}') ORDER BY id LIMIT 12);
----
[0, 3, 4, 10, 11, 13, 14, 20, 21, 22, 23, 24]

endloop

# OFFSET is part of the number of rows the kept files must provide
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/refpos') ORDER BY id DESC LIMIT 2 OFFSET 2);
----
[22, 21]

query I
SELECT opened_data_files('data/persistent/delete_statistics/refpos');
----
1

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/refpos') ORDER BY id DESC LIMIT 2 OFFSET 6);
----
[13, 11]

query I
SELECT opened_data_files('data/persistent/delete_statistics/refpos');
----
2

# Position deletes that name two files contribute no guaranteed rows: file 0 is not counted, so every file is scanned
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/refpos_overlap') ORDER BY id LIMIT 3);
----
[0, 3, 4]

query I
SELECT opened_data_files('data/persistent/delete_statistics/refpos_overlap');
----
2

# Equality deletes: an equality-deleted file counts 0, so the 2 rows of the top file are not taken as guaranteed
statement ok
CALL truncate_duckdb_logs();

query II
SELECT id, name FROM iceberg_scan('data/persistent/equality_deletes/warehouse/mydb/mytable') ORDER BY id DESC LIMIT 2;
----
5	e
4	d

query I
SELECT opened_data_files('data/persistent/equality_deletes/warehouse/mydb/mytable');
----
2

# Overlapping bounds: no file can be proven irrelevant, every file is scanned
statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_scan_order/overlap') ORDER BY ts LIMIT 4);
----
[1, 11, 21, 2]

query I
SELECT opened_data_files('data/persistent/delete_scan_order/overlap');
----
3

statement ok
CALL truncate_duckdb_logs();

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_scan_order/overlap') ORDER BY ts DESC LIMIT 4);
----
[24, 14, 4, 23]

query I
SELECT opened_data_files('data/persistent/delete_scan_order/overlap');
----
3

# Concurrent identical queries on several worker threads: the scan-order preparation reads delete manifests
# without holding the planner lock, so it must neither deadlock nor change the rows
statement ok
CALL disable_logging();

statement ok
SET threads=8;

concurrentloop i 0 32

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_statistics/refpos') ORDER BY id LIMIT 4);
----
[0, 3, 4, 10]

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_scan_order/parted') ORDER BY ts DESC LIMIT 7);
----
[34, 33, 32, 31, 24, 23, 22]

query I
SELECT list(id) FROM (SELECT id FROM iceberg_scan('data/persistent/delete_scan_order/parted') ORDER BY ts LIMIT 5 OFFSET 2);
----
[3, 4, 11, 12, 13]

endloop
